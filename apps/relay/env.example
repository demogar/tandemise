# The team relay's settings. Copy to .env next to compose.yaml and edit:
#   cp apps/relay/env.example apps/relay/.env

# The team's name, used once, on the first start.
RELAY_TEAM_NAME=Team

# Where teammates' daemons and webhook sources reach this relay. Builds webhook URLs.
# Must be https:// unless the relay listens on loopback only.
RELAY_PUBLIC_URL=https://relay.example.com
# The host part of RELAY_PUBLIC_URL, for the optional `tls` profile's Caddy.
RELAY_PUBLIC_HOST=relay.example.com
# A LAN-only setup over plain http:// (a warning is logged on every start). Leave unset otherwise.
# RELAY_INSECURE_HTTP=1

# The port the relay is published on, on the host, and the address it is published on.
RELAY_PORT=8787
RELAY_BIND=0.0.0.0
# Behind the `tls` profile's Caddy: set RELAY_BIND=127.0.0.1 and RELAY_TRUST_PROXY=1, so the relay is
# reached only through Caddy and its rate limits read Caddy's X-Forwarded-For. Leave both off otherwise:
# anyone can send that header.
# RELAY_TRUST_PROXY=1
# The SQLite file (WAL mode), on the relay-data volume.
# RELAY_DB=/data/relay.db (fixed inside the container)

# A claim is stale (any member may take it over) when its holder hasn't been seen for this long.
RELAY_STALE_AFTER=24h

# Webhook mailbox retention and caps.
RELAY_MAILBOX_ACKED_KEEP=24h
RELAY_MAILBOX_UNACKED_KEEP=14d
RELAY_MAILBOX_MAX_MESSAGES=10000
RELAY_MAILBOX_MAX_MB=200

# debug, info, warn or error.
RELAY_LOG_LEVEL=info
