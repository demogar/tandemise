<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime exceptions for Tandemise.app and its helpers.
  The app binary also runs the bundled daemon as Node (ELECTRON_RUN_AS_NODE):
  V8 needs JIT (allow-jit; Electron 12+ needs nothing broader, so
  allow-unsigned-executable-memory is not granted), and the daemon loads native
  addons (better-sqlite3, node-pty) that were not signed by the app's team, so
  library validation is off.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
